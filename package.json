{
  "name": "ai-roi-scorecard",
  "version": "0.1.0",
  "description": "Provider-neutral SDK for auditable AI value scorecards.",
  "license": "MIT",
  "author": "Ekin Burak Ozturk",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "import": "./dist/storage/index.js",
      "require": "./dist/storage/index.cjs"
    },
    "./storage/sqlite": {
      "types": "./dist/storage/sqlite.d.ts",
      "import": "./dist/storage/sqlite.js",
      "require": "./dist/storage/sqlite.cjs"
    },
    "./storage/postgres": {
      "types": "./dist/storage/postgres.d.ts",
      "import": "./dist/storage/postgres.js",
      "require": "./dist/storage/postgres.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsup",
    "build:python": "cd python && uv build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:python && pnpm check:schema && pnpm check:versions && pnpm check:boundary && pnpm test:examples",
    "check:boundary": "node scripts/check-public-boundary.mjs",
    "check:python": "cd python && uv run ruff check src tests && uv run mypy src && uv run pytest",
    "check:schema": "cd python && uv run python ../scripts/export_schema.py --check",
    "check:versions": "node scripts/check-version-sync.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:examples": "node examples/typescript/support-automation.mjs > /dev/null && cd python && uv run python ../examples/python/support_automation.py > /dev/null",
    "test:postgres": "vitest run tests/postgres.test.ts",
    "typecheck": "tsc --noEmit",
    "version:packages": "changeset version && node scripts/sync-python-version.mjs",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "eslint": "^9.34.0",
    "pg": "^8.16.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "ai",
    "roi",
    "scorecard",
    "automation",
    "evidence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ekinburak/AI-ROI-Scorecard.git"
  },
  "bugs": {
    "url": "https://github.com/ekinburak/AI-ROI-Scorecard/issues"
  },
  "homepage": "https://github.com/ekinburak/AI-ROI-Scorecard#readme"
}
